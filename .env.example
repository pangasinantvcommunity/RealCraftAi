# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# When true, the app never calls OpenAI, Vercel Blob, or Inngest — story
# generation is fully mocked (deterministic placeholder images/video,
# simulated progress) so you can develop locally for $0. See "Free Local
# Development" in README.md. Set to false (or omit) for real generation.
NEXT_PUBLIC_DEV_MODE=true

# ---------------------------------------------------------------------------
# Auth.js
# Generate with: npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# PostgreSQL — Neon
# DATABASE_URL: pooled endpoint ("-pooler" in hostname) — used at runtime.
# DIRECT_URL: direct endpoint (no "-pooler") — used by Prisma Migrate.
# Both require sslmode=require.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# OpenAI — Whisper transcription + image generation
# Not required when NEXT_PUBLIC_DEV_MODE=true.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_IMAGE_MODEL=gpt-image-1

# ---------------------------------------------------------------------------
# Vercel Blob — file storage (audio, images, rendered videos)
# Not required when NEXT_PUBLIC_DEV_MODE=true.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Inngest — background job orchestration
# Get these from https://app.inngest.com after connecting your Vercel project
# Not required when NEXT_PUBLIC_DEV_MODE=true.
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------------
# FFmpeg rendering
# ---------------------------------------------------------------------------
FFMPEG_TIMEOUT=600
# Optional: a public URL to a background music track, mixed at 20% volume.
FFMPEG_MUSIC_TRACK_URL=

# ---------------------------------------------------------------------------
# Story generation limits
# ---------------------------------------------------------------------------
STORY_DAILY_FREE_CREDITS=3
STORY_MAX_UPLOAD_MB=25
STORY_SCENE_COUNT=6
