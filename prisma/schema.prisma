generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VideoStatus {
  pending
  transcribing
  creating_scenes
  generating_images
  rendering
  completed
  failed
}

enum UserRole {
  user
  super_admin
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(user)
  videoCredits Int      @default(3) @map("video_credits")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  videos   Video[]
  projects Project[]

  @@map("users")
}

model Video {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  status          VideoStatus @default(pending)
  audioUrl        String?     @map("audio_url")
  transcript      String?
  videoUrl        String?     @map("video_url")
  durationSeconds Int?        @map("duration_seconds")
  metadata        Json?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Prompt-only cinematic story generator fields
  prompt         String?
  style          String?
  targetDuration Int?    @map("target_duration")
  title          String?
  summary        String?
  emotionalArc   Json?   @map("emotional_arc")
  aspectRatio    String  @default("9:16") @map("aspect_ratio")
  projectId      String? @map("project_id")

  // Episode draft workflow: a project episode can be saved without starting
  // generation, then generated later via a manual trigger.
  episodeNumber    Int?   @map("episode_number")
  partCount        Int?   @map("part_count")
  sceneCount       Int?   @map("scene_count")
  generationStatus String @default("draft") @map("generation_status")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id])
  scenes     Scene[]
  characters Character[]

  @@index([userId])
  @@index([status])
  @@index([projectId])
  @@map("videos")
}

model Scene {
  id         String   @id @default(uuid())
  videoId    String   @map("video_id")
  sceneOrder Int      @map("scene_order")
  prompt     String
  imageUrl   String?  @map("image_url")
  subtitle   String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, sceneOrder])
  @@index([videoId])
  @@map("scenes")
}

model Character {
  id          String   @id @default(uuid())
  videoId     String   @map("video_id")
  name        String
  description String?
  imageUrl    String   @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@map("characters")
}

model Project {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  title            String
  synopsis         String?
  storyBible       String?  @map("story_bible")
  runtimeStructure Json?    @map("runtime_structure")
  visualStyle      String   @default("3d-cinematic") @map("visual_style")
  aspectRatio      String   @default("9:16") @map("aspect_ratio")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters ProjectCharacter[]
  locations  ProjectLocation[]
  episodes   Video[]

  @@index([userId])
  @@index([title])
  @@map("projects")
}

model ProjectCharacter {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  name           String
  age            String?
  gender         String?
  appearance     String
  wardrobe       String?
  personality    String?
  role           String?
  relationships  String?
  voiceTone      String?  @map("voice_tone")
  cinematicNotes String?  @map("cinematic_notes")
  imageUrl       String?  @map("image_url")
  createdAt      DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([name])
  @@map("project_characters")
}

model ProjectLocation {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  description String
  mood        String?
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([name])
  @@map("project_locations")
}
